rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection storing player profile and cross-device progress
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Daily rankings collection for daily XP and Cash leaderboards
    match /daily_rankings/{date}/entries/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
